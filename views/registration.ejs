<%- include("partials/head.ejs") %>
<body>
    <div class="login-section">
        <h1>WELCOME TO THE P.B.L</h1>

        <div class="login-block registration-block">
            <h3>REGISTRATION</h3>
            <form class="login-form" action="/registration" method="post">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="pbl_user@gmail.com" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="********" required>

                <label for="repeat_password">Repeat password</label>
                <input type="password" id="repeat_password" placeholder="********" required>
                
                <button type="submit">Done</button>
            </form>
        </div>
    </div>
</body>
</html>