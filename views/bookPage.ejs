<%- include("partials/head.ejs") %>
<body>
    <%- include("partials/header.ejs") %>
    <section class="book-details-section">
        <a href="/">< Back</a>
        <div class="book-details">
            <div class="book-img-and-link">
                <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-L.jpg" alt="<%= book.title %>" class="book-page-img">
                <p class="book-page-link">Go to this page to see more details and reviews: <a target="_blank" href="<%= book.link %>"><%= book.title %> </a></p>
            </div>
            <div class="book-info">
                <h4 class="book-page-isbn">ISBN - <%= book.title %></h4>
                <h4 class="book-page-rating">Rating - <%= book.rating %></h4>
                <h4 class="book-page-start-date">Reading start date: <%= book.start_reading_date %></h4>
                <h4 class="book-page-end-date">Reading end date: <%= book.end_reading_date %></h4>
                <p class="book-page-description"><%= book.description %></p>
            </div>
        </div>

        <!-- TO-DO: NOTES SECTION -->
        <form action="/book/addNote" method="post">
            <input type="hidden" name="book_id" value="<%= book.id %>">

            <label for="note_text">Note text:</label>
            <textarea name="note_text" id="note_text" required></textarea>
            <button type="submit">Add</button>
        </form>

        <section class="notes-section">
            <% if(locals.notes && notes.length >= 1){ %>
                <% for(let note of notes){ %>
                    <div class="note">
                        <h3 class="note-date"><%= note.note_date %></h3>
                        <p class="note-text"><%= note.note_text %></p>     
                        <a href="/book/<%= book.id %>/note/<%= note.id %>/delete">Delete</a>         
                        
                        <form action="/book/note/update_note" method="post">
                            <input type="hidden" name="book_id" value="<%= book.id %>">
                            <input type="hidden" name="note_id" value="<%= note.id %>">

                            <h4>UPDATE NOTE</h4>

                            <label for="note_text">Note text:</label>
                            <textarea name="note_text" id="note_text" required><%= note.note_text %></textarea>

                            <button type="submit">Update</button>
                        </form>
                    </div>
                <% } %>                    
            <% }else {  %>
                <h4>There are no notes for that book! You can add one above...</h4>
            <% } %>
        </section>
    </section>
</body>
</html>