<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<body>
    <div class="login-section">
        <h1>WELCOME TO THE P.B.L</h1>

        <div class="login-block">
            <h3>LOGIN</h3>
            <form class="login-form" action="/login" method="post">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="pbl_user@gmail.com" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="********" required>

                <button type="submit">Login</button>
            </form>

            <% if(locals.registrationMessage){ %>
                <p class="registrationMessage"><%= registrationMessage %></p>    
            <% } %>
            <a href="/registration">Don't have an account?</a>
        </div>
    </div>
</body>
</html>